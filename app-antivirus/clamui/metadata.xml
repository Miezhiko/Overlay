	<longdescription lang="en">
		ClamUI is a modern Linux desktop interface for ClamAV, built with Rust, Tauri, and a React frontend.
		It provides a user-friendly GUI for managing ClamAV scans, updates, and configuration.
	</longdescription>
	<use>
		<flag name="test">Enable test suite (requires additional dependencies)</flag>
	</use>
	<upstream>
		<remote-id type="github">linx-systems/clamui</remote-id>
		<changelog>https://github.com/linx-systems/clamui/releases</changelog>
		<doc lang="en">https://clamui.com/docs/</doc>
	</upstream>
</pkgmetadata>
