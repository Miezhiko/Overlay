LICENSE="BSD"
SLOT="0/${PV}"
KEYWORDS="~amd64"
IUSE="+crypton"

RDEPEND=">=dev-haskell/primitive-0.7.2:=[profile?]
	>=dev-lang/ghc-9.0.2:=
