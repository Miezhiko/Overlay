			dev-haskell/ram:=[profile?] )
	!crypton? ( >=dev-haskell/cryptonite-0.26:=[profile?]
			dev-haskell/memory:=[profile?] )
"
DEPEND="${RDEPEND}
	>=dev-haskell/cabal-3.4.1.0
	test? ( dev-haskell/aeson
		dev-haskell/tasty
		dev-haskell/tasty-hunit
		dev-haskell/tasty-quickcheck
		dev-haskell/text
		dev-haskell/zlib )
"

src_configure() {
	haskell-cabal_src_configure \
		$(cabal_flag crypton use_crypton)
}
