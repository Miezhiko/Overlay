# Inlined npm eclass functions - must be defined before use
_npm_distfile() {
	local name=${1//\//+}
	echo "${name}-${2}.npm.tgz"
}

_npm_split() {
	local spec=${1%%|*}
	conds=
	[[ ${1} == *\|* ]] && conds=${1#*|}
	name=${spec%@*}
	version=${spec##*@}
	if [[ -z ${name} || -z ${version} || ${name} == "${spec}" ]]; then
		die "cannot parse NPM_PKGS entry: ${1}"
	fi
}

_npm_set_pkg_uris() {
	local entry name version conds base cond open close file
	local -a cond_list
	NPM_PKG_URIS=
	for entry in ${NPM_PKGS}; do
		_npm_split "${entry}"
		base=${name##*/}
		file=${name//\//+}-${version}.npm.tgz
		open= close=
		if [[ -n ${conds} ]]; then
			local IFS=,
			cond_list=( ${conds} )
			unset IFS
			for cond in "${cond_list[@]}"; do
				open+="${cond}? ( "
				close+=" )"
			done
		fi
		NPM_PKG_URIS+="${open}${NPM_REGISTRY_URI}/${name}/-/${base}-${version}.tgz -> ${file}${close}
"
	done
	if [[ -n ${NPM_PNPM_VERSION} ]]; then
		NPM_PKG_URIS+="${NPM_REGISTRY_URI}/pnpm/-/pnpm-${NPM_PNPM_VERSION}.tgz -> pnpm-${NPM_PNPM_VERSION}.npm-tool.tgz
"
	fi
}
_npm_set_pkg_uris

_bun_set_src_uri() {
	local dep name repo commit parts
	SRC_URI="
		https://github.com/oven-sh/bun/archive/refs/tags/bun-v${PV}.tar.gz -> ${P}.gh.tar.gz
		${BUN_NODEJS_HEADERS} -> bun-${BUN_NODEJS_HEADERS##*/}
		https://github.com/FireBurn/Overlay/releases/download/webkit-${BUN_WEBKIT_COMMIT}/WebKit-${BUN_WEBKIT_COMMIT}.tar.xz
	"
	for dep in "${BUN_VENDOR[@]}"; do
		parts=( ${dep} )
		name=${parts[0]} repo=${parts[1]} commit=${parts[2]}
		SRC_URI+=" https://github.com/${repo}/archive/${commit}.tar.gz -> bun-vendor-${name}-${commit}.gh.tar.gz"
	done
	# The build runs a handful of codegen scripts with bun itself
	SRC_URI+="
		!system-bootstrap? (
			amd64? ( https://github.com/oven-sh/bun/releases/download/bun-v${PV}/bun-linux-x64-baseline.zip
				-> bun-bootstrap-${PV}-x64-baseline.zip )
			arm64? ( https://github.com/oven-sh/bun/releases/download/bun-v${PV}/bun-linux-aarch64.zip
				-> bun-bootstrap-${PV}-aarch64.zip )
		)
		${CARGO_CRATE_URIS}
		${NPM_PKG_URIS}
	"
}
_bun_set_src_uri
unset -f _bun_set_src_uri

