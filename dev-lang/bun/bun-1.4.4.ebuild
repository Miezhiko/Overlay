# Inlined functions from npm.eclass

_npm_write_registry() {
	cat > "${1}" <<-'EOF' || die
	import { createServer } from "node:http";
	import { createHash } from "node:crypto";
	import { appendFileSync, readFileSync, writeFileSync } from "node:fs";
	import { gunzipSync } from "node:zlib";

	const dir = process.argv[2];
	const pkgs = new Map();
	for (const line of readFileSync(`${dir}/index`, "utf8").split("\n")) {
		if (!line) continue;
		let [name, version, path] = line.split("\t");
		const entry = path === "-" ? { stub: true } : { path };
		if (!name) {
			// Local tarball: name and version come from its package.json
			({ name, version } = load(entry).manifest);
		}
		if (!pkgs.has(name)) pkgs.set(name, new Map());
		pkgs.get(name).set(version, entry);
	}

	function manifest(tgz) {
		const tar = gunzipSync(tgz);
		let paxPath;
		for (let off = 0; off + 512 <= tar.length; ) {
			const hdr = tar.subarray(off, off + 512);
			if (hdr.every(b => b === 0)) break;
			const str = (a, b) => hdr.subarray(a, b).toString("utf8").replace(/\0.*$/s, "");
			const size = parseInt(str(124, 136).trim() || "0", 8);
			const type = str(156, 157);
			const data = tar.subarray(off + 512, off + 512 + size);
			let path = paxPath ?? (str(345, 500) ? `${str(345, 500)}/${str(0, 100)}` : str(0, 100));
			paxPath = undefined;
			if (type === "x") {
				const m = /\d+ path=([^\n]*)\n/.exec(data.toString("utf8"));
				if (m) paxPath = m[1];
			} else if (/^[^/]+\/package\.json$/.test(path)) {
				return JSON.parse(data.toString("utf8"));
			}
			off += 512 + Math.ceil(size / 512) * 512;
		}
		throw new Error("no package.json");
	}

	function load(entry) {
		if (entry.stub) return entry;
		if (!entry.data) {
			const data = readFileSync(entry.path);
			entry.data = data;
			entry.integrity = "sha512-" + createHash("sha512").update(data).digest("base64");
			entry.shasum = createHash("sha1").update(data).digest("hex");
			try { entry.manifest = manifest(data); } catch { entry.manifest = {}; }
		}
		return entry;
	}

	function semverGt(a, b) {
		const pa = a.split(/[.+]/).map(Number), pb = b.split(/[.+]/).map(Number);
		for (let i = 0; i < 3; i++) if (pa[i] !== pb[i]) return pa[i] > pb[i];
		return false;
	}

	function missing(what) {
		appendFileSync(`${dir}/missing.log`, what + "\n");
	}

	const server = createServer((req, res) => {
		const base = `http://${req.headers.host}/`;
		const path = decodeURIComponent(new URL(req.url, base).pathname).replace(/^\/+/, "");
		const tgz = path.indexOf("/-/");
		const send = (code, body, type) => {
			res.writeHead(code, { "content-type": type });
			res.end(body);
		};
		if (tgz !== -1) {
			const name = path.slice(0, tgz);
			const file = path.slice(tgz + 3);
			const prefix = `${name.split("/").pop()}-`;
			const version = file.startsWith(prefix) ? file.slice(prefix.length).replace(/\.tgz$/, "") : "";
			const entry = pkgs.get(name)?.get(version);
			if (!entry || entry.stub) { missing(`tarball\t${name}@${version || file}`); return send(404, "{}", "application/json"); }
			return send(200, load(entry).data, "application/octet-stream");
		}
		const versions = pkgs.get(path);
		if (!versions) { missing(`packument\t${path}`); return send(404, "{}", "application/json"); }
		// Fixed old publish times keep min-release-age style policies happy
		const epoch = "2000-01-01T00:00:00.000Z";
		const out = { name: path, versions: {}, "dist-tags": {}, time: { created: epoch, modified: epoch } };
		let latest;
		for (const [version, entry] of versions) {
			load(entry);
			out.time[version] = epoch;
			out.versions[version] = entry.stub ? {
				// Described so an installer can skip it, never downloaded
				name: path, version, os: ["none"], cpu: ["none"],
				dist: { tarball: `${base}${path}/-/stub-${version}.tgz` },
			} : {
				...entry.manifest, name: path, version,
				dist: {
					tarball: `${base}${path}/-/${path.split("/").pop()}-${version}.tgz`,
					integrity: entry.integrity, shasum: entry.shasum,
				},
			};
			if (!/-/.test(version) && (!latest || semverGt(version, latest))) latest = version;
		}
		out["dist-tags"].latest = latest ?? [...versions.keys()].pop();
		send(200, JSON.stringify(out), "application/json");
	});

	server.listen(0, "127.0.0.1", () => {
		writeFileSync(`${dir}/port`, String(server.address().port));
	});
	EOF
}

npm_setup_env() {
	debug-print-function ${FUNCNAME} "$@"

	export HOME="${T}/npm-home"
	mkdir -p "${HOME}" || die

	tc-export CC CXX AR RANLIB
	export CC_host=$(tc-getBUILD_CC) CXX_host=$(tc-getBUILD_CXX)

	# npm and node-gyp
	export npm_config_cache="${T}/npm-cache"
	export npm_config_nodedir="${BROOT}/usr"
	export npm_config_build_from_source=true
	export npm_config_audit=false
	export npm_config_fund=false
	export npm_config_update_notifier=false
	export npm_config_foreground_scripts=true
	export npm_config_progress=false
	export JOBS=$(makeopts_jobs)

	# npm's libc check reads /usr/bin/ldd, which can be a wrapper (e.g.
	# llvm-libc's) that names no family, so packages pinned to a libc are
	# silently skipped. The Node runtime report knows node's own libc.
	local glibc_ver
	glibc_ver=$(node -p "process.report.excludeNetwork = true;
		process.report.getReport().header.glibcVersionRuntime || ''" 2>/dev/null) \
		|| glibc_ver=
	[[ -n ${glibc_ver} ]] && export npm_config_libc=glibc

	# pnpm, yarn and bun keep their own stores
	export XDG_CONFIG_HOME="${HOME}/.config"
	export PNPM_HOME="${T}/pnpm-home"
	export YARN_CACHE_FOLDER="${T}/yarn-cache"
	export YARN_ENABLE_GLOBAL_CACHE=false
	export YARN_ENABLE_TELEMETRY=0
	export BUN_INSTALL_CACHE_DIR="${T}/bun-cache"
	export BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
	export COREPACK_ENABLE_NETWORK=0
	export COREPACK_ENABLE_STRICT=0

	if [[ -n ${NPM_PNPM_VERSION} ]]; then
		local tooldir="${T}/npm-tools"
		if [[ ! -x ${tooldir}/bin/pnpm ]]; then
			mkdir -p "${tooldir}/pnpm" "${tooldir}/bin" || die
			tar -C "${tooldir}/pnpm" --strip-components=1 -xzf \
				"${DISTDIR}/pnpm-${NPM_PNPM_VERSION}.npm-tool.tgz" || die
			printf '#!/bin/sh\nexec node "%s" "$@"\n' "${tooldir}/pnpm/bin/pnpm.cjs" \
				> "${tooldir}/bin/pnpm" || die
			chmod +x "${tooldir}/bin/pnpm" || die
		fi
		[[ :${PATH}: == *:${tooldir}/bin:* ]] || export PATH="${tooldir}/bin:${PATH}"
		# The version pinned in packageManager is the one we provide
		export npm_config_manage_package_manager_versions=false
	fi

	# Things that would otherwise try the network or fetch binaries
	export CI=true
	export HUSKY=0
	export DO_NOT_TRACK=1
	export DISABLE_TELEMETRY=1
	export NEXT_TELEMETRY_DISABLED=1
	export ELECTRON_SKIP_BINARY_DOWNLOAD=1
	export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
	export PUPPETEER_SKIP_DOWNLOAD=1
	export CYPRESS_INSTALL_BINARY=0
	export SHARP_IGNORE_GLOBAL_LIBVIPS=1
	export SENTRYCLI_SKIP_DOWNLOAD=1
}

npm_registry_start() {
	debug-print-function ${FUNCNAME} "$@"

	[[ -n ${_NPM_REGISTRY_PID} ]] && return
	npm_setup_env

	local dir="${T}/npm-registry"
	mkdir -p "${dir}" || die
	rm -f "${dir}"/{port,missing.log} || die

	local entry name version conds file
	local distdir=${PORTAGE_ACTUAL_DISTDIR:-${DISTDIR}}
	# Which distfiles this build actually has, as a set: NPM_PKGS runs to
	# thousands of entries, and searching ${A} for each one does not scale
	local -A fetched=()
	for file in ${A}; do
		fetched[${file}]=1
	done
	: > "${dir}/index" || die
	for entry in ${NPM_PKGS}; do
		_npm_split "${entry}"
		file=$(_npm_distfile "${name}" "${version}")
		if [[ -n ${fetched[${file}]} ]]; then
			printf '%s\t%s\t%s\n' "${name}" "${version}" "${distdir}/${file}" \
				>> "${dir}/index" || die
		else
			# Not fetched for this arch or libc: describe it as a platform
			# that cannot match, like NPM_STUB_PKGS
			printf '%s\t%s\t-\n' "${name}" "${version}" >> "${dir}/index" || die
		fi
	done
	for entry in ${NPM_STUB_PKGS}; do
		_npm_split "${entry}"
		printf '%s\t%s\t-\n' "${name}" "${version}" >> "${dir}/index" || die
	done
	for file in "${_NPM_LOCAL_TARBALLS[@]}"; do
		printf '\t\t%s\n' "${file}" >> "${dir}/index" || die
	done

	_npm_write_registry "${dir}/registry.mjs"

	node "${dir}/registry.mjs" "${dir}" > "${dir}/registry.log" 2>&1 &
	_NPM_REGISTRY_PID=$!

	local i
	for (( i = 0; i < 300; i++ )); do
		[[ -s ${dir}/port ]] && break
		kill -0 "${_NPM_REGISTRY_PID}" 2>/dev/null || break
		sleep 0.1
	done
	if [[ ! -s ${dir}/port ]]; then
		cat "${dir}/registry.log" >&2
		die "${ECLASS}: offline registry failed to start"
	fi

	local url="http://127.0.0.1:$(<"${dir}/port")/"
	# pnpm ignores npm_config_registry, so put it in the user config too
	cat > "${HOME}/.npmrc" <<-EOF || die
	registry=${url}
	store-dir=${T}/pnpm-store
	EOF
	export NPM_REGISTRY_LOCAL=${url}
	export npm_config_registry=${url}
	export NPM_CONFIG_REGISTRY=${url}
	export BUN_CONFIG_REGISTRY=${url}
	export YARN_REGISTRY=${url}
	export YARN_NPM_REGISTRY_SERVER=${url%/}
	export YARN_UNSAFE_HTTP_WHITELIST=127.0.0.1
	einfo "Offline npm registry serving $(wc -l < "${dir}/index") packages at ${url}"
	einfo "The install that follows unpacks and links every one of them, and"
	einfo "prints nothing while it does; expect several quiet minutes."
}

npm_registry_stop() {
	debug-print-function ${FUNCNAME} "$@"

	[[ -n ${_NPM_REGISTRY_PID} ]] || return
	kill "${_NPM_REGISTRY_PID}" 2>/dev/null
	wait "${_NPM_REGISTRY_PID}" 2>/dev/null
	unset _NPM_REGISTRY_PID NPM_REGISTRY_LOCAL

	# Tarball misses break installs; packument misses are usually optional
	# or platform-specific packages that were never needed.
	local log="${T}/npm-registry/missing.log"
	if [[ -s ${log} ]]; then
		local kind what
		while IFS=$'\t' read -r kind what; do
			case ${kind} in
				tarball) ewarn "Offline registry: tarball not in NPM_PKGS: ${what}" ;;
				*) debug-print "${ECLASS}: packument not in NPM_PKGS: ${what}" ;;
			esac
		done < <(sort -u "${log}")
		einfo "Unresolved registry requests are listed in ${log}"
	fi
}


pkg_pretend() {
	[[ ${MERGE_TYPE} != binary ]] && check-reqs_pkg_pretend
}

pkg_setup() {
	if [[ ${MERGE_TYPE} != binary ]]; then
		check-reqs_pkg_setup
		llvm-r2_pkg_setup
		rust_pkg_setup
		python-any-r1_pkg_setup
	fi
}

src_unpack() {
	unpack "${P}.gh.tar.gz"
	local archive
	for archive in ${A}; do
		[[ ${archive} == bun-bootstrap-*.zip ]] && unpack "${archive}"
	done

	# GitHub cannot archive the oven-sh/WebKit fork (too large), so
	# .github/workflows/webkit-tarball.yml publishes a git archive of the
	# pinned commit, without test suites, to the overlay's releases
	unpack "WebKit-${BUN_WEBKIT_COMMIT}.tar.xz"

	cargo_crate_unpack
	cargo_gen_config

	# Bun's downloader looks in the prefetch cache first, keyed by URL, so
	# point it at the verified distfiles
	local prefetch="${WORKDIR}/bun-prefetch/by-url" dep name repo commit key parts
	mkdir -p "${prefetch}" || die
	_bun_prefetch() {
		key=$(printf %s "${1}" | sha256sum) || die
		ln -s "${DISTDIR}/${2}" "${prefetch}/${key:0:32}" || die
	}
	for dep in "${BUN_VENDOR[@]}"; do
		parts=( ${dep} )
		name=${parts[0]} repo=${parts[1]} commit=${parts[2]}
		_bun_prefetch "https://github.com/${repo}/archive/${commit}.tar.gz" \
			"bun-vendor-${name}-${commit}.gh.tar.gz"
	done
	_bun_prefetch "${BUN_NODEJS_HEADERS}" "bun-${BUN_NODEJS_HEADERS##*/}"
}

src_prepare() {
	default

	eapply "${FILESDIR}/${P}-type-info.patch"
	eapply "${FILESDIR}/${P}-once-default.patch"

	# Use the CPU target from CFLAGS instead of upstream's portable baseline.
	# The same table feeds WebKit's flags and rustc's -Ctarget-cpu.
	local gentoo='process.env.BUN_GENTOO_CPU_FLAGS'
	local table="${gentoo} ? [{ flag: ${gentoo}.split(\" \"), when: () => true, desc: \"CFLAGS\" }] : ["
	sed -i -e "s|^export const cpuTargetFlags: Flag\[\] = \[\$|export const cpuTargetFlags: Flag[] = ${table}|" \
		scripts/build/flags.ts || die
	grep -q BUN_GENTOO_CPU_FLAGS scripts/build/flags.ts || die "failed to patch CPU target flags"

	# The libc crate versions its termios symbols for glibc targets, and an
	# unversioned libc has nothing for @GLIBC_x to bind to
	local crate
	for crate in "${ECARGO_HOME}/gentoo"/libc-0.2.*/src/unix/mod.rs; do
		[[ -f ${crate} ]] && sed -i -E \
			's/link_name = "([A-Za-z0-9_]+)@GLIBC_[0-9.]+"/link_name = "\1"/' "${crate}" || die
	done

	# Bun picks libstdc++ names for the V8 entry points that take std::
	# types on Linux, but this C++ is built against libc++ (std::__1::)
	if [[ $(tc-get-cxx-stdlib) == libc++ ]]; then
		sed -i \
			-e 's/EmSt8functionIFNS_10MaybeLocalINS_5ValueEEEvEE/EmNSt3__18functionIFNS_10MaybeLocalINS_5ValueEEEvEEE/' \
			-e 's/ESt8optionalImE/ENSt3__18optionalImEE/' \
			src/runtime/napi/napi_body.rs || die
	fi
}

src_compile() {
	local cpu=() flag
	if use amd64; then
		for flag in march mtune; do
			is-flagq "-${flag}=*" && cpu+=( "-${flag}=$(get-flag "${flag}")" )
		done
	else
		# Bun only translates -march=armv8-a for rustc; -mcpu maps directly
		is-flagq "-mcpu=*" && cpu+=( "-mcpu=$(get-flag mcpu)" )
	fi
	export BUN_GENTOO_CPU_FLAGS="${cpu[*]}"
	[[ -n ${BUN_GENTOO_CPU_FLAGS} ]] && einfo "CPU target: ${BUN_GENTOO_CPU_FLAGS}"

	export BUN_BUILD_PREFETCH_DIR="${WORKDIR}/bun-prefetch"
	export BUN_WEBKIT_PATH="${WORKDIR}/WebKit-${BUN_WEBKIT_COMMIT}"
	export BUN_TOOLCHAIN_LLVM=$(get_llvm_prefix -b)
	export BUN_TOOLCHAIN_RUST=$(get_rust_prefix)
	export CARGO_HOME="${ECARGO_HOME}"
	# The Rust sources use nightly features
	export RUSTC_BOOTSTRAP=1
	export GIT_SHA="${BUN_GIT_SHA}"

	npm_setup_env
	if ! use system-bootstrap; then
		local bootstrap=( "${WORKDIR}"/bun-linux-*/ )
		export PATH="${bootstrap[0]%/}:${PATH}"
	fi

	local lto=off
	tc-is-lto && lto=on

	npm_registry_start
	edo node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \
		scripts/build.ts --profile=release-local --canary=off --lto=${lto} \
		-j$(makeopts_jobs) -l$(makeopts_loadavg)
	npm_registry_stop
}

src_install() {
	dobin build/release/bun
	dosym bun /usr/bin/bunx

	newbashcomp completions/bun.bash bun
	newzshcomp completions/bun.zsh _bun
	dofishcomp completions/bun.fish

	einstalldocs
}
