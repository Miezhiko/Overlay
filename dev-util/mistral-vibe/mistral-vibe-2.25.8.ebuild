src_unpack() {
	cargo_src_unpack
}

python_prepare_all() {
	# _maturin_environment() unconditionally passes --zig and
	# --compatibility manylinux_2_28 to maturin for the wheel we actually
	# install, targeting a portable, hermetically-linked redistributable
	# wheel (via ziglang's bundled cross-libc). We're building natively
	# for this system with our own toolchain, so that's both unwanted and
	# an extra (unpackaged) ziglang dependency for nothing; neutralize it.
	sed -e '/^def _maturin_environment/a\    portable_linux_wheel = False  # Gentoo: native build, no zig cross-compile shim' \
		-i build_backend/maturin_backend.py || die
	grep -q 'Gentoo: native build' build_backend/maturin_backend.py || die "zig/manylinux patch didn't apply"

	distutils-r1_python_prepare_all
}

src_configure() {
	distutils-r1_src_configure
}

src_compile() {
	distutils-r1_src_compile
}

src_install() {
	distutils-r1_src_install
}
