DESCRIPTION="Minimal CLI coding agent by Mistral"
HOMEPAGE="https://github.com/mistralai/mistral-vibe"

# Upstream switched from a pure-Python hatchling build to a custom
# maturin-based backend (build_backend/maturin_backend.py, referenced from
# pyproject.toml's build-backend = "maturin_backend") that compiles two
# Rust components and bundles them into the wheel:
#   - harness/core: staged into .native-build/harness-core and built by
#     maturin itself as the actual PEP517 extension module
#     (mistralai_vibe_local_harness._native)
#   - vibe/cli-rust: a standalone "vibe-rs" binary built via a plain
#     cargo-build subprocess call and copied into vibe/_bin/
# CRATES above is the union of both components' Cargo.lock files (only the
# two root workspace crates themselves are excluded, as they're local paths
# with no SRC_URI of their own).
#
# The "v8" crate (rusty_v8 bindings, pulled in transitively) doesn't build
# V8 from source; its build.rs downloads a prebuilt static lib archive from
# GitHub releases at compile time, which the network-sandboxed build phase
# can't reach. Fetch it via SRC_URI instead and point RUSTY_V8_ARCHIVE (a
# build.rs-recognized override -- see its static_lib_url()/download_file())
# at the local copy; it auto-detects and decompresses the gzip archive
# itself, so no separate unpacking is needed. The exact filename encodes
# the crate version, enabled cargo features (here just "simdutf"), and
# target triple, so it'll need updating if the "v8" crate version above
# ever changes.
export RUSTY_V8_ARCHIVE="${DISTDIR}/librusty_v8_simdutf_release_x86_64-unknown-linux-gnu-150.3.0.a.gz"

SRC_URI="
	https://github.com/mistralai/${PN}/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	https://github.com/denoland/rusty_v8/releases/download/v150.3.0/librusty_v8_simdutf_release_x86_64-unknown-linux-gnu.a.gz -> librusty_v8_simdutf_release_x86_64-unknown-linux-gnu-150.3.0.a.gz
	${CARGO_CRATE_URIS}
"

